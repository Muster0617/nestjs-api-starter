# 应用（NODE_ENV: production 为生产，其余为开发）
NODE_ENV="development"

# HTTP 服务
HTTP_HOST="0.0.0.0"
HTTP_PORT=3001

# 认证 / JWT（密钥用 `openssl rand -base64 32` 生成；有效期支持 s/m/h/d/w）
AUTH_ACCESS_TOKEN_SECRET="change-me-access"
AUTH_REFRESH_TOKEN_SECRET="change-me-refresh"
AUTH_ACCESS_TOKEN_EXP="15m"
AUTH_REFRESH_TOKEN_EXP="7d"

# 数据库（Prisma CLI / 应用 / seed 共用；特殊字符须 URL 编码；?schema= 由应用取出传给 PrismaPg）
DATABASE_URL="postgresql://postgres:master123@localhost:5432/postgres?schema=public"

# Redis（密码与 docker-compose 一致；默认用户可省略用户名）
# 不要带 db 序号，库号由代码固定分配：业务 0 / 缓存 1 / 队列 2
REDIS_URL="redis://:master123@localhost:6379"

# 种子数据（生产须用密钥管理覆盖，勿用默认口令）
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@1234"
SEED_ADMIN_USERNAME="admin"

# 邮件（Gmail 需用应用专用密码；未配置仍可启动，仅发信报「邮件服务未配置」）
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM=""
