{
    "$schema": "https://swc.rs/schema.json",
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        },
        "target": "esnext"
    },
    "module": {
        "type": "commonjs"
    },
    "sourceMaps": true,
    "minify": false,
    "exclude": ["node_modules", "dist"]
}
