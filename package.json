{
    "name": "nestjs-api-starter",
    "version": "1.0.0",
    "description": "",
    "author": "",
    "private": true,
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "npm run typecheck && nest build",
        "pack": "node pack.mjs",
        "start": "node --enable-source-maps dist/main",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "docker": "docker compose up -d",
        "update:packages": "npx npm-check-updates -u",
        "db:push": "prisma generate && dotenv run -- prisma db push",
        "db:seed": "dotenv run -- prisma db seed",
        "pm2:start": "pm2 start ecosystem.config.cjs --env production",
        "pm2:logs": "pm2 logs nestjs-api-starter",
        "pm2:reload": "pm2 reload nestjs-api-starter",
        "pm2:stop": "pm2 stop nestjs-api-starter",
        "pm2:delete": "pm2 delete nestjs-api-starter",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "knip": "knip",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@nestjs/bullmq": "^12.0.0",
        "@nestjs/common": "^12.2.0",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.2.0",
        "@nestjs/jwt": "^12.0.3",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.2.0",
        "@nestjs/swagger": "^12.0.2",
        "@nestjs/terminus": "^12.1.0",
        "@nestjs/throttler": "^6.7.1",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "7.10.1",
        "argon2": "^0.45.1",
        "bullmq": "^6.4.0",
        "compression": "^1.8.2",
        "dotenv": "18.0.8",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "nestjs-pino": "^5.3.1",
        "nodemailer": "^10.2.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "pino-roll": "^4.0.0",
        "prisma": "7.10.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.10",
        "@standard-schema/spec": "^1.1.0",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.18",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.23.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "knip": "^6.42.1",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    }
}
